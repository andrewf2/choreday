# Copy to .env and fill in your key.

# SQLite database path (namespaced to avoid clashing with any DATABASE_URL
# already in your shell). Relative paths resolve against prisma/schema.prisma,
# so this points at prisma/dev.db for local development.
# In production (Fly volume) this is set to file:/data/prod.db.
CHOREDAY_DATABASE_URL=file:./dev.db

# Required for AI chore evaluation (the rest of the app works without it).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model evaluates submissions.
# Default is claude-sonnet-4-6 (good vision + cheaper than Opus).
# Options: claude-haiku-4-5 (cheapest), claude-sonnet-4-6, claude-opus-4-8 (most capable).
# CHORE_AI_MODEL=claude-sonnet-4-6

# Optional: directory for uploaded photos. Defaults to ./uploads locally;
# set to /data/uploads in production so they live on the Fly volume.
# UPLOADS_DIR=./uploads
