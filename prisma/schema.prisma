// Chore Checker AI — data model
// SQLite for the MVP. Lightweight parent/child profiles (no real auth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Namespaced to avoid colliding with any DATABASE_URL already in the shell.
  // Local dev -> prisma/dev.db; production -> Fly volume (file:/data/prod.db).
  url      = env("CHOREDAY_DATABASE_URL")
}

enum Role {
  PARENT
  CHILD
}

enum ChoreStatus {
  ACTIVE
  PENDING_REVIEW
  COMPLETED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Overall AI verdict for a submission.
enum OverallStatus {
  pass
  needs_work
  fail
}

// Per-standard AI verdict. Mirrors the spec: DONE / NOT_DONE / UNCLEAR.
enum ItemStatus {
  done
  not_done
  unclear
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  // Children link to their parent. Null for parents.
  parentId  String?
  parent    User?    @relation("ParentChildren", fields: [parentId], references: [id])
  children  User[]   @relation("ParentChildren")
  createdAt DateTime @default(now())

  // Accumulated, not-yet-paid-out allowance for a child (in cents).
  // Incremented when a submission is approved; reset to 0 on payout.
  allowanceBalanceCents Int @default(0)

  choresCreated  Chore[]      @relation("ChoresCreatedBy")
  choresAssigned Chore[]      @relation("ChoresAssignedTo")
  submissions    Submission[]
  payouts        Payout[]
}

model Chore {
  id               String      @id @default(cuid())
  name             String
  status           ChoreStatus @default(ACTIVE)
  // Optional reward for completing the chore, in cents. 0 = no allowance.
  allowanceCents   Int         @default(0)
  dueDate          DateTime?
  createdAt        DateTime    @default(now())

  assignedChildId String
  assignedChild   User   @relation("ChoresAssignedTo", fields: [assignedChildId], references: [id])

  createdById String
  createdBy   User   @relation("ChoresCreatedBy", fields: [createdById], references: [id])

  standards   Standard[]
  submissions Submission[]
}

// A single checklist item the AI grades against.
model Standard {
  id      String @id @default(cuid())
  text    String
  order   Int    @default(0)
  choreId String
  chore   Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)
}

model Submission {
  id               String           @id @default(cuid())
  note             String?
  status           SubmissionStatus @default(PENDING_REVIEW)
  aiScore          Int?
  aiOverallStatus  OverallStatus?
  // True once a parent has manually overridden the AI's decision.
  parentOverridden Boolean          @default(false)
  // Set when the AI evaluation could not run (e.g. API failure).
  aiError          String?
  // Allowance credited to the child when this submission was approved (cents).
  allowanceEarnedCents Int          @default(0)
  createdAt        DateTime         @default(now())

  choreId String
  chore   Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)

  childId String
  child   User   @relation(fields: [childId], references: [id])

  photos      SubmissionPhoto[]
  itemResults ItemResult[]
}

model SubmissionPhoto {
  id           String     @id @default(cuid())
  path         String // relative path under uploads/
  mediaType    String
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// A recorded allowance payout to a child (audit/history). Each payout zeroes
// the child's accumulated balance.
model Payout {
  id          String   @id @default(cuid())
  amountCents Int
  paidAt      DateTime @default(now())
  childId     String
  child       User     @relation(fields: [childId], references: [id])
}

// One row per standard, captured from the AI response for a submission.
model ItemResult {
  id           String     @id @default(cuid())
  standardText String
  status       ItemStatus
  feedback     String     @default("")
  order        Int        @default(0)
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
